rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'Admin' || request.auth.token.email == 'admin@rodstar.co.ke');
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Applications collection
    match /applications/{appId} {
      allow read: if true; // Public read for verification & dashboard status
      allow create, update: if true; // Allow submission & payment updates
      allow delete: if isAdmin();
    }

    // 2. Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Payments collection
    match /payments/{txRef} {
      allow read: if true;
      allow create, update: if true; // PayHero backend webhooks
      allow delete: if isAdmin();
    }

    // 4. Opportunities collection
    match /opportunities/{oppId} {
      allow read: if true; // Public verified job board
      allow write: if isAdmin();
    }

    // 5. Courses collection
    match /courses/{courseId} {
      allow read: if true; // Public LMS training materials
      allow write: if isAdmin();
    }

    // 6. Certificates collection
    match /certificates/{certId} {
      allow read: if true; // Public verification endpoint
      allow write: if true;
    }

    // 7. AuditLogs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }
  }
}
